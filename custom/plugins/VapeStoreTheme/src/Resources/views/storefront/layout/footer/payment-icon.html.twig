{#
    Ödeme / kargo marka işareti — inline SVG (config-driven logo şeridi).

    Core payment/shipping method medyası DB'de boş; bu partial tanınabilir,
    basitleştirilmiş/jenerik marka işaretlerini çizer (gerçek logo dosyası GÖMÜLMEZ —
    telif için sadeleştirilmiş temsili işaretler). Logolar açık çip zemininde durur
    (bkz _footer.scss §7), o yüzden marka renkleri koyu footer'da değil AÇIK çipte
    değerlendirilir ve okunur kalır.

    Erişilebilirlik: her SVG role="img" + aria-label (marka adı snippet'ten).
    Boyut: viewBox oranı korunur, yükseklik SCSS'ten ($vape-footer-pay-logo-h).

    Beklenen değişken: name ∈ { visa, mastercard, paypal, klarna, sepa, dhl }
                       label (çevrilmiş aria-label metni)
#}
{% set name = name|default('') %}
{% set label = label|default('') %}
{% apply spaceless %}
    <span class="vape-footer-pay__logo" role="img" aria-label="{{ label }}">
        {% if name == 'visa' %}
            <svg viewBox="0 0 48 16" height="16" focusable="false" aria-hidden="true">
                <path fill="#1a1f71" d="M19.6 1.1 17 14.9h-3.2L16.4 1.1h3.2Zm13.5 8.9 1.7-4.6.9 4.6h-2.6ZM36.6 15h3l-2.6-13.9h-2.7c-.6 0-1.1.4-1.4 1L27.8 15h3.4l.7-1.9h4.2l.5 1.9Zm-8.4-4.5c0-3.3-4.5-3.5-4.5-4.9 0-.5.4-.9 1.3-1 .5-.1 1.7-.1 3.1.5l.6-2.7C27.6 1.5 26.6 1 25.3 1c-3.2 0-5.4 1.7-5.4 4.1 0 1.8 1.6 2.8 2.8 3.4 1.2.6 1.7 1 1.6 1.6 0 .8-1 1.2-1.9 1.2-1.6 0-2.5-.4-3.2-.8l-.6 2.8c.7.3 2.1.6 3.5.7 3.4 0 5.6-1.7 5.6-4.3ZM15 1.1 9.7 15H6.3L3.7 4.9c-.2-.6-.3-.9-.8-1.1C2.1 3.4 1 3.1 0 2.9l.1-.4h5.5c.7 0 1.3.5 1.5 1.3l1.4 7.3 3.5-8.6H15Z"/>
            </svg>
        {% elseif name == 'mastercard' %}
            <svg viewBox="0 0 32 20" height="20" focusable="false" aria-hidden="true">
                <circle cx="12" cy="10" r="8" fill="#eb001b"/>
                <circle cx="20" cy="10" r="8" fill="#f79e1b"/>
                <path fill="#ff5f00" d="M16 3.9a8 8 0 0 0 0 12.2 8 8 0 0 0 0-12.2Z"/>
            </svg>
        {% elseif name == 'paypal' %}
            <svg viewBox="0 0 48 16" height="16" focusable="false" aria-hidden="true">
                <path fill="#003087" d="M8.9 1.5H4.2c-.4 0-.7.3-.8.7L1.5 14.4c0 .3.2.5.4.5h2.3c.4 0 .7-.3.8-.7l.5-3.3c.1-.4.4-.7.8-.7h1.5c3.1 0 4.9-1.5 5.4-4.5.2-1.3 0-2.3-.6-3-.7-.8-1.9-1.2-3.4-1.2Zm.5 4.4c-.3 1.7-1.5 1.7-2.8 1.7h-.7l.5-3.1c0-.2.2-.3.4-.3h.3c.9 0 1.7 0 2.1.5.3.3.3.7.2 1.2Z"/>
                <path fill="#0070e0" d="M20.9 5.8h-2.3c-.2 0-.4.2-.4.4l-.1.6-.2-.2c-.5-.7-1.5-.9-2.6-.9-2.4 0-4.5 1.8-4.9 4.4-.2 1.3.1 2.5.8 3.4.7.8 1.6 1.1 2.7 1.1 1.9 0 3-1.2 3-1.2l-.1.6c0 .3.2.5.4.5h2c.4 0 .7-.3.8-.7l1.2-7.5c0-.3-.2-.5-.4-.5Zm-3.2 4.3c-.2 1.2-1.2 2.1-2.4 2.1-.6 0-1.1-.2-1.4-.6-.3-.4-.4-.9-.3-1.5.2-1.2 1.2-2.1 2.4-2.1.6 0 1.1.2 1.4.6.3.4.4.9.3 1.5Z"/>
                <path fill="#003087" d="M33.4 5.8h-2.3c-.2 0-.4.1-.6.3l-3.2 4.7-1.3-4.5c-.1-.3-.4-.5-.7-.5h-2.3c-.3 0-.5.3-.4.5l2.5 7.3-2.3 3.3c-.2.3 0 .6.3.6h2.3c.2 0 .4-.1.6-.3l7.5-10.8c.2-.3 0-.6-.4-.6Z"/>
                <path fill="#0070e0" d="M40.8 1.5h-4.7c-.4 0-.7.3-.8.7l-1.9 12.2c0 .3.2.5.4.5h2.4c.3 0 .5-.2.5-.5l.5-3.4c.1-.4.4-.7.8-.7h1.5c3.1 0 4.9-1.5 5.4-4.5.2-1.3 0-2.3-.6-3-.7-.8-1.9-1.2-3.4-1.2Zm.5 4.4c-.3 1.7-1.5 1.7-2.8 1.7h-.7l.5-3.1c0-.2.2-.3.4-.3h.3c.9 0 1.7 0 2.1.5.3.3.4.7.2 1.2Z"/>
            </svg>
        {% elseif name == 'klarna' %}
            <svg viewBox="0 0 32 16" height="16" focusable="false" aria-hidden="true">
                <rect width="32" height="16" rx="2" fill="#ffb3c7"/>
                <path fill="#0a0b09" d="M9.8 4.2H8.1v7.6h1.7V4.2Zm4.7 0c0 1.6-.6 3.1-1.7 4.2l2.4 3.4h-2.1l-2.6-3.7.7-.5c1-.8 1.6-2 1.6-3.4h1.7Zm3.7 0h-1.7v7.6h1.7V4.2Zm5.2 2.2c-.6 0-1.2.2-1.6.6v-.5h-1.6v5.3h1.7V8.9c0-.7.4-1.1 1-1.1.6 0 .9.4.9 1.1v2.9h1.7V8.5c0-1.3-.8-2.1-2-2.1Zm3.9 4.2a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/>
            </svg>
        {% elseif name == 'sepa' %}
            <svg viewBox="0 0 40 16" height="16" focusable="false" aria-hidden="true">
                <path fill="#10298e" d="M6.6 3.4c1.3 0 2.5.5 3.3 1.4l1.3-1.5A6.1 6.1 0 0 0 6.6 1.4C3.5 1.4 1 3.7 1 6.7v2.6c0 3 2.5 5.3 5.6 5.3 1.8 0 3.4-.7 4.6-2l-1.3-1.5c-.8.9-2 1.4-3.3 1.4-1.9 0-3.4-1.4-3.4-3.2V6.6c0-1.8 1.5-3.2 3.4-3.2Z"/>
                <path fill="#ffcc00" d="M13.4 5.5h9.4l-.6 1.7h-9.4l.6-1.7Zm-.9 3.3h9.4l-.6 1.7h-9.4l.6-1.7Z"/>
                <path fill="#10298e" d="M27 1.6h-2.2l-3 12.8h2.1l.6-2.7h3.3l.6 2.7h2.2L29 3.1c-.2-.9-.9-1.5-2-1.5Zm-2 8.1 1.1-5 1.1 5H25Zm10.6-8.1h-3.5v12.8h2.1V9.9h1.4c2.7 0 4.4-1.6 4.4-4.2s-1.6-4.1-4.4-4.1Zm-.2 6.4h-1.2V3.5h1.2c1.4 0 2.3.8 2.3 2.2s-.9 2.3-2.3 2.3Z"/>
            </svg>
        {% elseif name == 'dhl' %}
            <svg viewBox="0 0 44 12" height="12" focusable="false" aria-hidden="true">
                <path fill="#d40511" d="M11.5 3.6 10.3 5H3.9l.7-.9c.4-.5.5-.5 1.1-.5h5.8Zm-.9 1.2L9.5 6.3H3.1L3.8 5.4c.4-.5.5-.5 1.1-.5h5.7ZM2.3 6.5l.7-.9c.4-.5.5-.5 1.1-.5h5.7L8.4 6.9H2.6c-.5 0-.5-.2-.3-.4Zm35.6-2.9-2.4 3.2h-2.8l2.4-3.2h2.8Zm3.9 0-.9 1.2c-.5.6-.1.7.5.7H43l.7-.9h-2.1l.4-.5c.4-.5.5-.5 1.1-.5H41Zm-13.5 0-2.4 3.2h6.6c2.2 0 3-1.4 3.6-2.2.5-.6.2-1-.7-1h-7.1Zm2.1 1h2.1c.4 0 .4.2.3.4-.2.2-.4.4-.9.4h-2.1l.6-.8ZM17.6 3.6l-2.4 3.2h2.7l1-1.3h3l-1 1.3h2.7l2.4-3.2h-2.7l-.9 1.1h-3l.9-1.1h-2.7Z"/>
                <path fill="#ffcc00" d="M1 8.4h42v1.2H1z"/>
            </svg>
        {% endif %}
    </span>
{% endapply %}

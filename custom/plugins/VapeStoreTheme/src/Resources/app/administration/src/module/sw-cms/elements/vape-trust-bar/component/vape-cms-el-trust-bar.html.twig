{#
    Güven şeridi — CMS editörü içindeki önizleme.
    Storefront'un sadeleştirilmiş yansıması: 4 kart tarzı kutu.
    İkonlar mt-icon ile (admin set); storefront gerçek sw_icon'u basar.
#}
{% block vape_cms_el_trust_bar %}
<div class="vape-cms-el-trust-bar">

    {% block vape_cms_el_trust_bar_empty %}
        <div v-if="!items.length" class="vape-cms-el-trust-bar__empty">
            <mt-icon name="regular-shield-check" size="28px" />
            <p>{{ $t('vape-cms.elements.trustBar.config.emptyHint') }}</p>
        </div>
    {% endblock %}

    {% block vape_cms_el_trust_bar_grid %}
        <div v-else class="vape-cms-el-trust-bar__grid">
            <div
                v-for="(item, index) in items"
                :key="index"
                class="vape-cms-el-trust-bar__card"
            >
                <span class="vape-cms-el-trust-bar__icon" aria-hidden="true">
                    <mt-icon :name="adminIcon(item)" size="30px" />
                </span>
                <span class="vape-cms-el-trust-bar__title">{{ item.title }}</span>
                <span v-if="item.text" class="vape-cms-el-trust-bar__sub">{{ item.text }}</span>
            </div>
        </div>
    {% endblock %}

</div>
{% endblock %}
